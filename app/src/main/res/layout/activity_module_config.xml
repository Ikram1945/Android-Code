<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/IconButton.SunnyGlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan Proyek"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_panel"
            android:layout_margin="12dp">

            <TextView style="@style/label" android:text="Package APK"/>
            <EditText android:id="@+id/cfgPkg"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView style="@style/label" android:text="versionName"/>
            <EditText android:id="@+id/cfgVerName"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView style="@style/label" android:text="versionCode"/>
            <EditText android:id="@+id/cfgVerCode"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number"/>

            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView style="@style/label" android:text="compileSdk"/>
                    <EditText android:id="@+id/cfgCompile"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginEnd="6dp">
                    <TextView style="@style/label" android:text="minSdk"/>
                    <EditText android:id="@+id/cfgMin"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/label" android:text="targetSdk"/>
                    <EditText android:id="@+id/cfgTarget"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/label" android:text="Versi Java"/>
            <RadioGroup android:id="@+id/cfgJava"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/cfgRadio17"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Java 17"/>
                <RadioButton android:id="@+id/cfgRadio21"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Java 21"/>
            </RadioGroup>

            <TextView style="@style/label" android:text="Eksekusi Compiler Java (module.toml [build] javaExec)"/>
            <RadioGroup android:id="@+id/cfgJavaExec"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/cfgJavaInproc" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="In-Process" android:checked="true"/>
                <RadioButton android:id="@+id/cfgJavaFork" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Fork (dalvikvm)"/>
            </RadioGroup>

            <TextView style="@style/label" android:text="Eksekusi Compiler Kotlin (module.toml [build] kotlinExec)"/>
            <RadioGroup android:id="@+id/cfgKotlinExec"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/cfgKotlinInproc" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="In-Process" android:checked="true"/>
                <RadioButton android:id="@+id/cfgKotlinFork" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Fork (dalvikvm)"/>
            </RadioGroup>

            <TextView style="@style/label" android:text="Kotlin Fork Worker (module.toml [build] kotlinExec=forkworker)"/>
            <RadioGroup android:id="@+id/cfgKotlinWorker"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/cfgKotlinWorkerOn" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Fork Worker"/>
                <RadioButton android:id="@+id/cfgKotlinWorkerOff" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Nonaktif" android:checked="true"/>
            </RadioGroup>

            <TextView style="@style/label" android:text="Heap Worker Kotlin"/>
            <TextView android:id="@+id/txtCfgKotlinHeapVal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0 MB (auto)" android:textColor="?android:attr/textColorSecondary"/>
            <SeekBar android:id="@+id/sbCfgKotlinHeap"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="4" android:progress="0"/>

            <TextView style="@style/label" android:text="Max Fork Merge D8 (dexMergeForks)"/>
            <TextView android:id="@+id/txtCfgDexForksVal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0 (auto, max 3)" android:textColor="?android:attr/textColorSecondary"/>
            <SeekBar android:id="@+id/sbCfgDexForks"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="8" android:progress="0"/>

            <TextView style="@style/label" android:text="Mode Dex (module.toml [build] dexMode)"/>
            <RadioGroup android:id="@+id/cfgDex"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/dexAuto" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="auto"/>
                <RadioButton android:id="@+id/dexFull" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="full"/>
                <RadioButton android:id="@+id/dexInc" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="incremental"/>
            </RadioGroup>

            <CheckBox android:id="@+id/chkParallel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Merge D8 paralel (untuk proyek besar)"/>

            <TextView style="@style/label" android:text="DEPENDENCIES (pilih yang sudah diunduh)"/>
            <Button android:id="@+id/depPick"
                style="@style/Button.Outline.SunnyGlow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Pilih Library (✓ pasang)"/>
            <ListView android:id="@+id/depList"
                android:layout_width="match_parent" android:layout_height="140dp"
                android:layout_marginTop="4dp"
                android:divider="@android:color/transparent" android:dividerHeight="4dp"/>
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tip: sentuh lama item untuk hapus. Library harus diunduh dulu di menu Unduh Library."
                android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
                android:paddingTop="4dp"/>

            <Button android:id="@+id/btnSaveConfig"
                style="@style/Button.SunnyGlow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Simpan"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
