<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================
         Sunny Glow (palet AndroidIDE/ACS) & Blue Wave (AndroidIDE-R)
         theme — AppCompatActivity parent Theme.MaterialComponents (M2).
         Item di-set 2 versi: attr M2 (colorPrimary, colorSurfaceVariant,
         ...) utk komponen AppCompat/Material & drawable pakai ?attr,
         DAN android:* utk view framework.
         ================================================================ -->

    <!-- Sunny Glow light (default) -->
    <style name="Theme.App" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- attr Material/AppCompat -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/tertiary</item>
        <item name="colorSecondaryVariant">@color/tertiary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorControlNormal">@color/on_surface_variant</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlHighlight">@color/on_primary_container</item>
        <item name="android:buttonStyle">@style/Button.SunnyGlow</item>
        <item name="android:editTextStyle">@style/EditText.SunnyGlow</item>
        <item name="android:radioButtonStyle">@style/Radio.SunnyGlow</item>
        <item name="android:checkboxStyle">@style/Check.SunnyGlow</item>
        <item name="android:listViewStyle">@style/ListView.SunnyGlow</item>
    </style>

    <!-- Sunny Glow dark -->
    <style name="Theme.App.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary_dark</item>
        <item name="colorOnSecondary">@color/on_primary_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_container_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:colorPrimary">@color/primary_dark</item>
        <item name="android:colorPrimaryDark">@color/surface_dark</item>
        <item name="android:colorAccent">@color/primary_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/on_surface_dark</item>
        <item name="android:textColorSecondary">@color/on_surface_variant_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:colorControlNormal">@color/on_surface_variant_dark</item>
        <item name="android:colorControlActivated">@color/primary_dark</item>
        <item name="android:colorControlHighlight">@color/on_primary_container_dark</item>
        <item name="android:buttonStyle">@style/Button.SunnyGlow</item>
        <item name="android:editTextStyle">@style/EditText.SunnyGlow</item>
        <item name="android:radioButtonStyle">@style/Radio.SunnyGlow</item>
        <item name="android:checkboxStyle">@style/Check.SunnyGlow</item>
        <item name="android:listViewStyle">@style/ListView.SunnyGlow</item>
    </style>

    <!-- Blue Wave light (preset ala AndroidIDE-R theme_blue_wave.xml) -->
    <style name="Theme.App.BlueWave" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bw_primary</item>
        <item name="colorPrimaryVariant">@color/bw_primary</item>
        <item name="colorSecondary">@color/bw_secondary</item>
        <item name="colorSecondaryVariant">@color/bw_secondary</item>
        <item name="colorOnPrimary">@color/bw_on_primary</item>
        <item name="colorOnSecondary">@color/bw_on_secondary</item>
        <item name="colorSurface">@color/bw_surface</item>
        <item name="colorSurfaceVariant">@color/bw_surface_variant</item>
        <item name="colorOnSurface">@color/bw_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/bw_on_surface_variant</item>
        <item name="colorOutline">@color/bw_outline</item>
        <item name="colorError">@color/bw_error</item>
        <item name="android:colorBackground">@color/bw_surface</item>
        <item name="android:colorPrimary">@color/bw_primary</item>
        <item name="android:colorAccent">@color/bw_primary</item>
        <item name="android:windowBackground">@color/bw_surface</item>
        <item name="android:textColorPrimary">@color/bw_on_surface</item>
        <item name="android:textColorSecondary">@color/bw_on_surface_variant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/bw_surface</item>
        <item name="android:navigationBarColor">@color/bw_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorControlNormal">@color/bw_on_surface_variant</item>
        <item name="android:colorControlActivated">@color/bw_primary</item>
        <item name="android:colorControlHighlight">@color/bw_primary</item>
        <item name="android:buttonStyle">@style/Button.SunnyGlow</item>
        <item name="android:editTextStyle">@style/EditText.SunnyGlow</item>
        <item name="android:radioButtonStyle">@style/Radio.SunnyGlow</item>
        <item name="android:checkboxStyle">@style/Check.SunnyGlow</item>
        <item name="android:listViewStyle">@style/ListView.SunnyGlow</item>
    </style>

    <!-- Blue Wave dark -->
    <style name="Theme.App.BlueWave.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/bw_primary_dark</item>
        <item name="colorPrimaryVariant">@color/bw_primary_dark</item>
        <item name="colorSecondary">@color/bw_secondary_dark</item>
        <item name="colorSecondaryVariant">@color/bw_secondary_dark</item>
        <item name="colorOnPrimary">@color/bw_on_primary_dark</item>
        <item name="colorOnSecondary">@color/bw_on_secondary_dark</item>
        <item name="colorSurface">@color/bw_surface_dark</item>
        <item name="colorSurfaceVariant">@color/bw_surface_variant_dark</item>
        <item name="colorOnSurface">@color/bw_on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/bw_on_surface_variant_dark</item>
        <item name="colorOutline">@color/bw_outline_dark</item>
        <item name="colorError">@color/bw_error_dark</item>
        <item name="android:colorBackground">@color/bw_surface_dark</item>
        <item name="android:colorPrimary">@color/bw_primary_dark</item>
        <item name="android:colorPrimaryDark">@color/bw_surface_dark</item>
        <item name="android:colorAccent">@color/bw_primary_dark</item>
        <item name="android:windowBackground">@color/bw_surface_dark</item>
        <item name="android:textColorPrimary">@color/bw_on_surface_dark</item>
        <item name="android:textColorSecondary">@color/bw_on_surface_variant_dark</item>
        <item name="android:statusBarColor">@color/bw_surface_dark</item>
        <item name="android:navigationBarColor">@color/bw_surface_dark</item>
        <item name="android:colorControlNormal">@color/bw_on_surface_variant_dark</item>
        <item name="android:colorControlActivated">@color/bw_primary_dark</item>
        <item name="android:colorControlHighlight">@color/bw_primary_dark</item>
        <item name="android:buttonStyle">@style/Button.SunnyGlow</item>
        <item name="android:editTextStyle">@style/EditText.SunnyGlow</item>
        <item name="android:radioButtonStyle">@style/Radio.SunnyGlow</item>
        <item name="android:checkboxStyle">@style/Check.SunnyGlow</item>
        <item name="android:listViewStyle">@style/ListView.SunnyGlow</item>
    </style>

    <!-- Tombol: warna ambil dari tema (?attr) biar ikut preset Sunny/BlueWave -->
    <style name="Button.SunnyGlow" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Outline button: transparan + border colorPrimary dari tema -->
    <style name="Button.Outline.SunnyGlow" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- IconButton: tombol icon-only (ImageButton), bg transparan -->
    <style name="IconButton.SunnyGlow" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_ripple</item>
        <item name="android:minWidth">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">4dp</item>
    </style>
    <!-- IconButton filled (aksi utama build): lingkaran warna primary -->
    <style name="IconButton.SunnyGlow.Filled" parent="android:Widget.ImageButton">
        <item name="android:background">@drawable/bg_fab</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">6dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Fab: lingkaran warna primary (dari tema) -->
    <style name="Fab.SunnyGlow" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_fab</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:elevation">6dp</item>
    </style>

    <!-- EditText: garis bawah + teks; kurangi kontras keras Material default -->
    <style name="EditText.SunnyGlow" parent="android:Widget.Material.EditText">
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Radio.SunnyGlow" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:colorAccent">?attr/colorPrimary</item>
    </style>

    <style name="Check.SunnyGlow" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:colorAccent">?attr/colorPrimary</item>
    </style>

    <style name="ListView.SunnyGlow" parent="android:Widget.Material.ListView">
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <!-- label field form -->
    <style name="label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
